{
  "editor.formatOnSave": true,
  "prettierMove.printWidth": 80,
  "prettierMove.tabWidth": 2,
  "prettierMove.wrapComments": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/build": true,
    "**/target": true,
    "**/.direnv": true,
    "**/.devenv": true
  },
  "[json][javascript][typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  }
  // "rust-analyzer.check.overrideCommand": ["cargo", "clippy"]
}
